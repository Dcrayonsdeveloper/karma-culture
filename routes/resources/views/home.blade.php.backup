    <x-slot name="styles">
        <style>
            /* ===== Kingdom of White-Inspired Luxury Design System ===== */
            :root {
                --kow-gold: #ab8c52;
                --kow-gold-light: #c4a96c;
                --kow-gold-dark: #967a45;
                --kow-cream: #fcfbf9;
                --kow-beige: #f5f2ec;
                --kow-dark: #212121;
                --kow-text: #212121;
                --kow-muted: #757575;
                --kow-border: #e8e3da;
            }

            /* ===== HERO BANNER ===== */
            .hero-banner { position: relative; width: 100%; overflow: hidden; }
            .hero-banner img { width: 100%; height: 560px; object-fit: cover; object-position: center; display: block; }
            .hero-slides { position: relative; height: 560px; }
            .hero-slide {
