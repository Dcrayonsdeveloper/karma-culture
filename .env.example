# ============================================================
#  Karmaa Kulture — Environment template
#  Copy to .env and fill real values.  NEVER commit the real .env.
#  PRODUCTION values are shown in the comments next to each key.
# ============================================================

APP_NAME="Karmaa Kulture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
#  PRODUCTION:  APP_ENV=production  APP_DEBUG=false  APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
#  PRODUCTION:  LOG_LEVEL=error  (and consider LOG_CHANNEL=daily to rotate logs)

# ---- Database (app runs on MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Karmaculture
DB_USERNAME=root
DB_PASSWORD=
#  PRODUCTION:  point at the production MySQL host and use a dedicated
#               database user with a strong password - never root.

# ---- Session / Cache / Queue (all DB-driven — no Redis needed on shared hosting) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true        # PRODUCTION: set true once HTTPS is live
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
#  Public uploads are served via the storage symlink; keep FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
#  PRODUCTION shared hosting: either run `queue:work` from a cron (recommended,
#  the app dispatches queued jobs), OR set QUEUE_CONNECTION=sync to run inline.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---- Redis (NOT used on shared hosting — leave as-is) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Search (Laravel Scout). Default engine = collection.
#      Use the database engine in production for efficient LIKE search. ----
SCOUT_DRIVER=database

# ---- Mail ----
# `log` writes every message into storage/logs and sends NOTHING. It is the
# right local default and the wrong production one: the site ran on it for
# months while the forgot-password form told customers to check their inbox.
# Any environment that real people use needs the smtp block below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
#
#  PRODUCTION - Gmail / Google Workspace SMTP, which is what the live site uses:
#    MAIL_MAILER=smtp   MAIL_HOST=smtp.gmail.com
#    MAIL_PORT=465      MAIL_SCHEME=smtps
#    MAIL_USERNAME=<the full mailbox address>
#    MAIL_PASSWORD=<16-character Google App Password, not the account password>
#    MAIL_FROM_ADDRESS=<the same mailbox, or a verified alias of it>
#
#  Port and scheme go together: 465 with smtps, or 587 with tls. Mixing them
#  hangs until the socket times out. Gmail rewrites or refuses a From address
#  that is not the authenticated mailbox, so MAIL_FROM_ADDRESS is not free.
#  Most hosts allow outbound 465 and 587 while blocking 25.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Analytics / Pixels (optional — leave blank to disable) ----
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=

# ---- Anthropic (AI chatbot) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Nia AI Chatbot (Meta / WhatsApp) ----
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# NOTE: PayU and Shiprocket credentials are NOT stored here — they are configured
# at runtime in the Admin panel (Settings table). Nothing to set in .env for those.

SHIPROCKET_WEBHOOK_TOKEN=

# ---- Hosts this shop previously answered on ----
# Comma separated, no scheme needed beyond what you paste. Used once, by the
# migration that repoints settings (og_image and friends) off an address the
# project no longer controls. Leave blank unless the site has actually moved.
RETIRED_HOSTS=

# ---- Instagram feed (home page strip) ----
# Read through the Facebook Graph API, not Basic Display: the token is a
# Facebook system-user token and graph.instagram.com cannot parse one.
#
# INSTAGRAM_USER_ID is the Instagram BUSINESS account id, not the handle. Find
# it once with:  GET /v21.0/{page-id}?fields=instagram_business_account
#
# Point these at THE SHOP'S OWN account. A testing account here puts somebody
# else's posts on the storefront. Leave both blank and the strip hides itself.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
