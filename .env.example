# ============================================================
#  Karmaa Kulture — Environment template
#  Copy to .env and fill real values.  NEVER commit the real .env.
#  PRODUCTION values are shown in the comments next to each key.
# ============================================================

APP_NAME="Karmaa Kulture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
#  PRODUCTION:  APP_ENV=production  APP_DEBUG=false  APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
#  PRODUCTION:  LOG_LEVEL=error  (and consider LOG_CHANNEL=daily to rotate logs)

# ---- Database (app runs on MySQL — Hostinger MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Karmaculture
DB_USERNAME=root
DB_PASSWORD=
#  PRODUCTION (Hostinger):  DB_HOST=localhost  DB_DATABASE=u32xxxx_karmaa
#                           DB_USERNAME=u32xxxx_karmaa  DB_PASSWORD=<strong-password>

# ---- Session / Cache / Queue (all DB-driven — no Redis needed on shared hosting) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true        # PRODUCTION: set true once HTTPS is live
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
#  Public uploads are served via the storage symlink; keep FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
#  PRODUCTION shared hosting: either run `queue:work` from a cron (recommended,
#  the app dispatches queued jobs), OR set QUEUE_CONNECTION=sync to run inline.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---- Redis (NOT used on shared hosting — leave as-is) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Search (Laravel Scout). Default engine = collection.
#      Use the database engine in production for efficient LIKE search. ----
SCOUT_DRIVER=database

# ---- Mail (defaults to log — set real SMTP for production) ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
#  PRODUCTION (Hostinger SMTP):  MAIL_MAILER=smtp  MAIL_HOST=smtp.hostinger.com
#  MAIL_PORT=465  MAIL_SCHEME=smtps  MAIL_USERNAME=you@your-domain.com
#  MAIL_PASSWORD=<mailbox-password>  MAIL_FROM_ADDRESS=you@your-domain.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Analytics / Pixels (optional — leave blank to disable) ----
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=

# ---- Anthropic (AI chatbot) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Nia AI Chatbot (Meta / WhatsApp) ----
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# NOTE: PayU and Shiprocket credentials are NOT stored here — they are configured
# at runtime in the Admin panel (Settings table). Nothing to set in .env for those.
