    @if(!isset($sections['newsletter']) || $sections['newsletter']->is_active)
    <section class="newsletter">
        <div class="container mx-auto px-4 lg:px-12">
            <div class="max-w-2xl mx-auto text-center">
                <h2>{{ $sections['newsletter']->title ?? 'Join Our Community' }}</h2>
                @if(isset($sections['newsletter']) && $sections['newsletter']->subtitle)
                    <p>{{ $sections['newsletter']->subtitle }}</p>
                @else
                    <p>Be the first to know about new arrivals, exclusive offers & style inspiration.</p>
                @endif
                <form class="newsletter-form"
                      x-data="{ email: '', loading: false, message: '', success: false }"
                      @submit.prevent="
                          loading = true; message = '';
                          fetch('/newsletter/subscribe', {
                              method: 'POST',
                              headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{{ csrf_token() }}' },
                              body: JSON.stringify({ email, source: 'homepage' })
                          }).then(r => r.json()).then(data => {
                              success = data.success; message = data.message; loading = false;
                              if (data.success) email = '';
                          }).catch(() => { message = 'Something went wrong. Please try again.'; loading = false; })
                      ">
                    <template x-if="message">
                        <p class="w-full text-sm text-center py-2" :class="success ? 'text-[#ab8c52]' : 'text-red-300'" x-text="message"></p>
                    </template>
                    <template x-if="!message">
                        <input type="email" x-model="email" required placeholder="Enter your email address" class="newsletter-input">
                    </template>
                    <button type="submit" :disabled="loading" x-show="!message" class="newsletter-btn">
                        <span x-text="loading ? 'Subscribing...' : 'Subscribe'">Subscribe</span>
                    </button>
                </form>
            </div>
        </div>
    </section>
    @endif

    <script>
        function productSlider() {
            return {
                atStart: true,
                atEnd: false,
                init() { this.$nextTick(() => this.updateArrows()); },
                updateArrows() {
                    const el = this.$refs.slider;
                    if (!el) return;
                    this.atStart = el.scrollLeft <= 5;
                    this.atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 5;
                },
                scrollLeft() {
                    this.$refs.slider.scrollBy({ left: -this.$refs.slider.clientWidth * 0.75, behavior: 'smooth' });
                },
                scrollRight() {
                    this.$refs.slider.scrollBy({ left: this.$refs.slider.clientWidth * 0.75, behavior: 'smooth' });
                }
            };
        }
    </script>

</x-layouts.app>
